---
import type { Props } from '@astrojs/starlight/props';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const locale = Astro.props.locale ?? '';
const isDE = locale === 'de';
const isSplash = Astro.url.pathname === '/' || Astro.url.pathname === '/de/';
const hasSidebar = (Astro.props.hasSidebar ?? true) && !isSplash;

const hubHref       = isDE ? '/de/hub'       : '/hub';
const edgeHref      = isDE ? '/de/edge'      : '/edge';
const companionHref = isDE ? '/de/companion' : '/companion';
const deepviewHref  = isDE ? '/de/deepview'  : '/deepview';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
    <span class="docs-label">docs</span>
  </div>

  <nav class="product-nav">
    <a href={hubHref}       class="pnav" id="pnav-hub">Hub</a>
    <a href={edgeHref}      class="pnav" id="pnav-edge">Edge</a>
    <a href={companionHref} class="pnav" id="pnav-companion">Companion</a>
    <a href={deepviewHref}  class="pnav" id="pnav-deepview">Deepview</a>
  </nav>

  <div class="header-spacer"></div>

  <div class="search-col sl-flex print:hidden" transition:persist="search">
    <Search {...Astro.props} />
  </div>

  <div class="right-group print:hidden">
    <ThemeSelect {...Astro.props} />
    <LanguageSelect {...Astro.props} />
  </div>

  <button class="mobile-splash-btn print:hidden" id="mobile-splash-btn" aria-label="Navigation" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<nav class="mobile-splash-nav print:hidden" id="mobile-splash-nav" hidden>
  <a href={hubHref}       class="msn-link">Hub</a>
  <a href={edgeHref}      class="msn-link">Edge (Crawler)</a>
  <a href={companionHref} class="msn-link">Companion</a>
  <a href={deepviewHref}  class="msn-link">Deepview</a>
</nav>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
      width: 100%;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex-shrink: 0;
      align-items: center;
      gap: 0.5rem;
    }

    .docs-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--sl-color-gray-3);
      opacity: 0.7;
      padding: 2px 6px;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 4px;
      line-height: 1.4;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Hide site title text — keep logo only */
    .title-wrapper :global(.site-title span:not(:has(img))) {
      display: none;
    }

    .product-nav {
      display: flex;
      gap: 2px;
      align-items: center;
      flex-shrink: 0;
    }

    .pnav {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--sl-color-gray-3);
      text-decoration: none;
      padding: 5px 10px;
      border-radius: 6px;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
      line-height: 1.4;
      display: inline-flex;
      align-items: center;
    }

    .pnav:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    :root[data-theme='light'] .pnav:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-gray-1);
    }

    .pnav.active {
      background: var(--sl-color-gray-5);
      color: var(--sl-color-white);
      font-weight: 600;
    }

    :root[data-theme='light'] .pnav.active {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-gray-1);
    }

    .header-spacer {
      flex: 1;
      min-width: 0;
    }

    .search-col {
      flex: 0 0 280px;
    }

    @media (max-width: 49.999rem) {
      /* Spacer stays visible → pushes search + controls to the right */
      .search-col { flex: 0 0 auto; }
    }

    .right-group {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-shrink: 0;
    }

    @media (min-width: 50rem) {
      .right-group {
        margin-left: calc(0.5rem - var(--sl-nav-gap));
      }
    }

    /* Mobile hamburger: hidden on desktop, always shown on mobile (global style) */
    .mobile-splash-btn {
      display: none;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--sl-color-white);
      padding: 0.35rem;
      flex-shrink: 0;
      width: 2rem;
      height: 2rem;
      border-radius: 6px;
    }
    .mobile-splash-btn .close-icon { display: none; }
    .mobile-splash-btn[aria-expanded="true"] .menu-icon { display: none; }
    .mobile-splash-btn[aria-expanded="true"] .close-icon { display: block; }

    @media (min-width: 50rem) {
      .mobile-splash-btn { display: none !important; }
    }

    @media (max-width: 49.999rem) {
      .docs-label { display: none; }
      .right-group { gap: 0.25rem; }
      .header { gap: 0.375rem; }
    }

    @media (max-width: 50rem) {
      .product-nav { display: none; }
    }
  }
</style>

<style is:global>
  /* On mobile: always show our custom hamburger button */
  @media (max-width: 49.999rem) {
    .mobile-splash-btn { display: flex !important; }
  }

  /* Splash product nav overlay */
  .mobile-splash-nav {
    position: fixed;
    top: var(--sl-nav-height, 3.5rem);
    left: 0;
    right: 0;
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 200;
  }
  .mobile-splash-nav[hidden] { display: none !important; }
  .msn-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
  }
  .msn-link:hover { background: var(--sl-color-gray-6); }
</style>

<script>
  // ── Changelog version badges ──────────────────────────────
  function initChangelogBadges() {
    const isChangelog = window.location.pathname.includes('changelog');
    document.body.classList.toggle('changelog-page', isChangelog);
    if (!isChangelog) return;

    const content = document.querySelector('.sl-markdown-content');
    if (!content) return;

    // Badge each h2
    content.querySelectorAll('h2').forEach(h2 => {
      if (h2.querySelector('.version-badge')) return;
      const text = h2.textContent.trim();
      h2.innerHTML = '<span class="version-badge">' + text + '</span>';
    });

    // Add emojis to h3 labels
    const emojiMap = {
      'highlights': '✦',
      'new features': '↑',
      'neue funktionen': '↑',
      'bug fixes': '✓',
      'fehlerbehebungen': '✓',
      'technical appendix': '◆',
      'technischer anhang': '◆',
    };
    content.querySelectorAll('h3').forEach(h3 => {
      if (h3.querySelector('.cl-emoji')) return;
      const key = h3.textContent.toLowerCase().trim();
      const emoji = emojiMap[key];
      if (emoji) {
        h3.innerHTML = '<span class="cl-emoji">' + emoji + '</span> ' + h3.textContent.trim();
      }
    });

    // Split card content: bold title on its own line, text below
    content.querySelectorAll('li').forEach(li => {
      if (li.querySelector('.cl-item-title')) return;
      const strong = li.querySelector('strong');
      if (!strong) return;
      const title = strong.textContent.trim();
      // Get remaining text after strong (skip em dash and leading space)
      let desc = '';
      strong.nextSiblings = [];
      let node = strong.nextSibling;
      while (node) {
        desc += node.textContent || '';
        node = node.nextSibling;
      }
      desc = desc.replace(/^\s*[—–-]\s*/, '').trim();
      li.innerHTML =
        '<div class="cl-item-title">' + title + '</div>' +
        (desc ? '<div class="cl-item-desc">' + desc + '</div>' : '');
    });
  }
  initChangelogBadges();
  document.addEventListener('astro:page-load', initChangelogBadges);
  document.addEventListener('astro:after-swap', initChangelogBadges);

  // ── Lightbox ──────────────────────────────────────────────
  (function() {
    function ensureLightbox() {
      if (document.getElementById('sl-lightbox')) return;
      const lb = document.createElement('div');
      lb.id = 'sl-lightbox';
      lb.innerHTML = '<button id="sl-lightbox-close">✕</button><img id="sl-lightbox-img" src="" alt="" />';
      document.body.appendChild(lb);
      lb.addEventListener('click', () => lb.classList.remove('open'));
      document.getElementById('sl-lightbox-close').addEventListener('click', e => { e.stopPropagation(); lb.classList.remove('open'); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') lb.classList.remove('open'); });
    }

    function makeZoomBtn(img) {
      const btn = document.createElement('button');
      btn.className = 'zoom-btn';
      btn.setAttribute('aria-label', 'Zoom');
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>';
      btn.addEventListener('click', e => {
        e.stopPropagation();
        document.getElementById('sl-lightbox-img').src = img.src;
        document.getElementById('sl-lightbox').classList.add('open');
      });
      return btn;
    }

    function initZoomBtns() {
      ensureLightbox();
      document.querySelectorAll('.screenshot-frame, .page-hero-image').forEach(frame => {
        if (frame.querySelector('.zoom-btn')) return;
        const img = frame.querySelector('img');
        if (!img) return;
        frame.appendChild(makeZoomBtn(img));
      });
      document.querySelectorAll('.qs-img-slide').forEach(slide => {
        if (slide.querySelector('.zoom-btn')) return;
        const img = slide.querySelector('img');
        if (!img) return;
        slide.appendChild(makeZoomBtn(img));
      });
      document.querySelectorAll('.companion-banner').forEach(frame => {
        if (frame.querySelector('.zoom-btn')) return;
        const img = frame.querySelector('img');
        if (!img) return;
        const btn = makeZoomBtn(img);
        btn.style.cssText = 'position:absolute;bottom:10px;right:10px;width:32px;height:32px;background:rgba(0,0,0,0.55);border:none;border-radius:6px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;z-index:10;';
        frame.appendChild(btn);
      });
      document.querySelectorAll('.carousel-slide').forEach(slide => {
        if (slide.querySelector('.zoom-btn')) return;
        const img = slide.querySelector('img');
        if (!img) return;
        const btn = makeZoomBtn(img);
        slide.appendChild(btn);
        img.addEventListener('mouseenter', () => { btn.style.opacity = '1'; });
        img.addEventListener('mouseleave', (e) => { if (e.relatedTarget !== btn && !btn.contains(e.relatedTarget)) btn.style.opacity = '0'; });
        btn.addEventListener('mouseleave', () => { btn.style.opacity = '0'; });
      });
      document.querySelectorAll('.doc-acc-img-wrap').forEach(wrap => {
        if (wrap.querySelector('.zoom-btn')) return;
        const img = wrap.querySelector('img');
        if (!img) return;
        wrap.appendChild(makeZoomBtn(img));
      });
    }

    initZoomBtns();
    document.addEventListener('astro:page-load', initZoomBtns);
    document.addEventListener('astro:after-swap', initZoomBtns);
  })();

  // ── Quickstart / How-To tabs: each .qs-stepper is independent ───

  // Event delegation: one persistent listener handles all tab clicks,
  // regardless of when the DOM was built or swapped by View Transitions.
  document.addEventListener('click', (e: MouseEvent) => {
    const tab = (e.target as HTMLElement).closest<HTMLElement>('.qs-tab');
    if (!tab) return;
    e.preventDefault();
    e.stopPropagation();
    const stepper = tab.closest<HTMLElement>('.qs-stepper');
    if (!stepper) return;
    const tabs   = Array.from(stepper.querySelectorAll<HTMLElement>(':scope > .qs-tabbar > .qs-tab'));
    const panels = Array.from(stepper.querySelectorAll<HTMLElement>(':scope > .qs-panels > .qs-panel'));
    const index  = tabs.indexOf(tab);
    if (index < 0) return;
    panels.forEach((p, i) => p.classList.toggle('qs-active', i === index));
    tabs.forEach((t, i)   => t.classList.toggle('qs-active', i === index));
    const stepperIdx = Array.from(document.querySelectorAll('.qs-stepper')).indexOf(stepper);
    sessionStorage.setItem(`qs-tab:${location.pathname}:${stepperIdx}`, String(index));
  }, true);

  // Restore active tab after every page load / View Transition swap.
  // No qsReady guard — this is idempotent (just sets classes).
  function initQsTabs() {
    document.querySelectorAll<HTMLElement>('.qs-stepper').forEach((stepper, stepperIdx) => {
      const tabs   = Array.from(stepper.querySelectorAll<HTMLElement>(':scope > .qs-tabbar > .qs-tab'));
      const panels = Array.from(stepper.querySelectorAll<HTMLElement>(':scope > .qs-panels > .qs-panel'));
      if (!tabs.length || !panels.length) return;

      const storageKey = `qs-tab:${location.pathname}:${stepperIdx}`;
      const savedIndex = parseInt(sessionStorage.getItem(storageKey) || '-1', 10);
      const initial    = savedIndex >= 0 && savedIndex < tabs.length ? savedIndex : 0;

      panels.forEach((p, i) => p.classList.toggle('qs-active', i === initial));
      tabs.forEach((t, i)   => t.classList.toggle('qs-active', i === initial));
    });
  }

  initQsTabs();
  document.addEventListener('astro:page-load', initQsTabs);
  document.addEventListener('astro:after-swap', initQsTabs);

  // ── Glossary accordion (.ht-glossary) ───────────────────────────────
  document.addEventListener('click', (e: MouseEvent) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('.ht-glossary-trigger');
    if (!trigger) return;
    const item = trigger.closest<HTMLElement>('.ht-glossary-item');
    if (!item) return;
    const glossary = item.closest<HTMLElement>('.ht-glossary');
    if (!glossary) return;
    const isOpen = item.classList.contains('open');
    glossary.querySelectorAll<HTMLElement>('.ht-glossary-item').forEach(i => {
      i.classList.remove('open');
      i.querySelector<HTMLElement>('.ht-glossary-trigger')?.setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }
  });

  // ── Quickstart image carousel (.qs-img-carousel) ────────────────────
  function initQsImgCarousels() {
    document.querySelectorAll<HTMLElement>('.qs-img-carousel').forEach(carousel => {
      if ((carousel as any)._qsImgReady) return;
      (carousel as any)._qsImgReady = true;
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.qs-img-slide'));
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.qs-img-next');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.qs-img-prev');
      if (slides.length < 2) return;
      let idx = 0;
      function showSlide(i: number) {
        slides.forEach((s, j) => s.classList.toggle('qs-img-active', j === i));
        if (prevBtn) prevBtn.style.display = i > 0 ? 'flex' : 'none';
        if (nextBtn) nextBtn.style.display = i < slides.length - 1 ? 'flex' : 'none';
      }
      nextBtn?.addEventListener('click', () => { idx = Math.min(idx + 1, slides.length - 1); showSlide(idx); });
      prevBtn?.addEventListener('click', () => { idx = Math.max(idx - 1, 0); showSlide(idx); });
      showSlide(0);
    });
  }
  initQsImgCarousels();
  document.addEventListener('astro:page-load', initQsImgCarousels);

  // ── Image toggles (arrow button cycles through images) ──────────────
  function initImgToggles() {
    document.querySelectorAll<HTMLElement>('.img-toggle').forEach(wrapper => {
      if ((wrapper as any)._toggleReady) return;
      (wrapper as any)._toggleReady = true;
      const imgs: string[] = JSON.parse(wrapper.dataset.imgs || '[]');
      if (imgs.length < 2) return;
      let idx = 0;
      const img = wrapper.querySelector('img') as HTMLImageElement;
      const btn = wrapper.querySelector<HTMLButtonElement>('.img-toggle-btn');
      if (!img || !btn) return;
      btn.addEventListener('click', () => {
        idx = (idx + 1) % imgs.length;
        img.src = imgs[idx];
      });
    });
  }
  initImgToggles();
  document.addEventListener('astro:page-load', initImgToggles);

  // ── Keep language prefix when navigating between products ────
  function updateProductNavLinks() {
    const isDE   = window.location.pathname.startsWith('/de');
    const prefix = isDE ? '/de' : '';
    const hub      = document.getElementById('pnav-hub')      as HTMLAnchorElement | null;
    const edge     = document.getElementById('pnav-edge')     as HTMLAnchorElement | null;
    const comp     = document.getElementById('pnav-companion') as HTMLAnchorElement | null;
    const deepview = document.getElementById('pnav-deepview') as HTMLAnchorElement | null;
    if (hub)      hub.href      = prefix + '/hub';
    if (edge)     edge.href     = prefix + '/edge';
    if (comp)     comp.href     = prefix + '/companion';
    if (deepview) deepview.href = prefix + '/deepview';
  }

  function setActiveProduct() {
    const path     = window.location.pathname;
    const hub      = document.getElementById('pnav-hub');
    const edge     = document.getElementById('pnav-edge');
    const comp     = document.getElementById('pnav-companion');
    const deepview = document.getElementById('pnav-deepview');
    [hub, edge, comp, deepview].forEach(el => el?.classList.remove('active'));
    if      (path === '/' || path === '/de' || path === '/de/')  { /* splash — nothing active */ }
    else if (path.includes('/edge'))      edge?.classList.add('active');
    else if (path.includes('/companion')) comp?.classList.add('active');
    else if (path.includes('/deepview'))  deepview?.classList.add('active');
    else                                  hub?.classList.add('active');
    updateProductNavLinks();
  }

  setActiveProduct();
  document.addEventListener('astro:page-load',  setActiveProduct);
  document.addEventListener('astro:after-swap', setActiveProduct);

  // ── Mobile hamburger: handles both splash overlay and sidebar toggle ──
  let _splashObserver: MutationObserver | null = null;

  function initSplashBtn() {
    const btn = document.getElementById('mobile-splash-btn') as HTMLButtonElement | null;
    const nav = document.getElementById('mobile-splash-nav') as HTMLElement | null;
    if (!btn || !nav) return;

    // Reconnect observer each call so it stays current after page navigations
    if (_splashObserver) _splashObserver.disconnect();
    _splashObserver = new MutationObserver(() => {
      if (!document.querySelector('.sidebar-pane')) return;
      btn.setAttribute('aria-expanded', String(document.body.hasAttribute('data-mobile-menu-expanded')));
    });
    _splashObserver.observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });

    if ((btn as any)._splashReady) return;
    (btn as any)._splashReady = true;

    btn.addEventListener('click', () => {
      if (document.querySelector('.sidebar-pane')) {
        // Product page: trigger the PageFrame's hamburger (sibling of .sidebar-pane)
        const starlightBtn = document.querySelector<HTMLButtonElement>('nav.sidebar starlight-menu-button button');
        if (starlightBtn) {
          starlightBtn.click();
          btn.setAttribute('aria-expanded', String(document.body.hasAttribute('data-mobile-menu-expanded')));
        }
      } else {
        // Splash page: show/hide product nav overlay
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav.hidden = open;
      }
    });

    // Close splash nav when a link is clicked
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        nav.hidden = true;
      });
    });
  }

  // Also update splash nav hrefs after navigation (locale can change)
  function updateSplashNavLinks() {
    const isDE   = window.location.pathname.startsWith('/de');
    const prefix = isDE ? '/de' : '';
    const links  = document.querySelectorAll<HTMLAnchorElement>('.msn-link');
    const targets = [prefix + '/hub', prefix + '/edge', prefix + '/companion', prefix + '/deepview'];
    links.forEach((a, i) => { if (targets[i]) a.href = targets[i]; });
  }

  initSplashBtn();
  updateSplashNavLinks();
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-splash-btn') as HTMLButtonElement | null;
    if (btn) btn.setAttribute('aria-expanded', 'false');
    initSplashBtn();
    updateSplashNavLinks();
  });
  document.addEventListener('astro:after-swap', updateSplashNavLinks);
</script>
