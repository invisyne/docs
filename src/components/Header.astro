---
import type { Props } from '@astrojs/starlight/props';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const locale = Astro.props.locale ?? '';
const isDE = locale === 'de';

const hubHref       = isDE ? '/de/hub'       : '/hub';
const edgeHref      = isDE ? '/de/edge'      : '/edge';
const companionHref = isDE ? '/de/companion' : '/companion';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
    <span class="docs-label">docs</span>
  </div>

  <nav class="product-nav">
    <a href={hubHref}       class="pnav" id="pnav-hub">Hub</a>
    <a href={edgeHref}      class="pnav" id="pnav-edge">Edge</a>
    <a href={companionHref} class="pnav" id="pnav-companion">Companion</a>
  </nav>

  <div class="search-col sl-flex print:hidden">
    <Search {...Astro.props} />
  </div>

  <div class="right-group print:hidden">
    <ThemeSelect {...Astro.props} />
    <LanguageSelect {...Astro.props} />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
      width: 100%;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex-shrink: 0;
      align-items: center;
      gap: 0.5rem;
    }

    .docs-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--sl-color-gray-3);
      opacity: 0.7;
      padding: 2px 6px;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 4px;
      line-height: 1.4;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Hide site title text — keep logo only */
    .title-wrapper :global(.site-title span:not(:has(img))) {
      display: none;
    }

    .product-nav {
      display: flex;
      gap: 2px;
      align-items: center;
      flex-shrink: 0;
    }

    .pnav {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--sl-color-gray-3);
      text-decoration: none;
      padding: 5px 10px;
      border-radius: 6px;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
      line-height: 1.4;
      display: inline-flex;
      align-items: center;
    }

    .pnav:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    :root[data-theme='light'] .pnav:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-gray-1);
    }

    .pnav.active {
      background: var(--sl-color-gray-5);
      color: var(--sl-color-white);
      font-weight: 600;
    }

    :root[data-theme='light'] .pnav.active {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-gray-1);
    }

    .search-col {
      flex: 1;
      min-width: 0;
    }

    .right-group {
      display: none;
      gap: 0.5rem;
      align-items: center;
      flex-shrink: 0;
    }

    @media (min-width: 50rem) {
      .right-group {
        display: flex;
      }
    }
  }
</style>

<script>
  // ── Changelog version badges ──────────────────────────────
  function initChangelogBadges() {
    const isChangelog = window.location.pathname.includes('changelog');
    document.body.classList.toggle('changelog-page', isChangelog);
    if (!isChangelog) return;

    const content = document.querySelector('.sl-markdown-content');
    if (!content) return;

    // Badge each h2
    content.querySelectorAll('h2').forEach(h2 => {
      if (h2.querySelector('.version-badge')) return;
      const text = h2.textContent.trim();
      h2.innerHTML = '<span class="version-badge">' + text + '</span>';
    });

    // Add emojis to h3 labels
    const emojiMap = {
      'highlights': '✦',
      'new features': '↑',
      'neue funktionen': '↑',
      'bug fixes': '✓',
      'fehlerbehebungen': '✓',
      'technical appendix': '◆',
      'technischer anhang': '◆',
    };
    content.querySelectorAll('h3').forEach(h3 => {
      if (h3.querySelector('.cl-emoji')) return;
      const key = h3.textContent.toLowerCase().trim();
      const emoji = emojiMap[key];
      if (emoji) {
        h3.innerHTML = '<span class="cl-emoji">' + emoji + '</span> ' + h3.textContent.trim();
      }
    });

    // Split card content: bold title on its own line, text below
    content.querySelectorAll('li').forEach(li => {
      if (li.querySelector('.cl-item-title')) return;
      const strong = li.querySelector('strong');
      if (!strong) return;
      const title = strong.textContent.trim();
      // Get remaining text after strong (skip em dash and leading space)
      let desc = '';
      strong.nextSiblings = [];
      let node = strong.nextSibling;
      while (node) {
        desc += node.textContent || '';
        node = node.nextSibling;
      }
      desc = desc.replace(/^\s*[—–-]\s*/, '').trim();
      li.innerHTML =
        '<div class="cl-item-title">' + title + '</div>' +
        (desc ? '<div class="cl-item-desc">' + desc + '</div>' : '');
    });
  }
  initChangelogBadges();
  document.addEventListener('astro:page-load', initChangelogBadges);
  document.addEventListener('astro:after-swap', initChangelogBadges);

  // ── Lightbox ──────────────────────────────────────────────
  (function() {
    function ensureLightbox() {
      if (document.getElementById('sl-lightbox')) return;
      const lb = document.createElement('div');
      lb.id = 'sl-lightbox';
      lb.innerHTML = '<button id="sl-lightbox-close">✕</button><img id="sl-lightbox-img" src="" alt="" />';
      document.body.appendChild(lb);
      lb.addEventListener('click', () => lb.classList.remove('open'));
      document.getElementById('sl-lightbox-close').addEventListener('click', e => { e.stopPropagation(); lb.classList.remove('open'); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') lb.classList.remove('open'); });
    }

    function makeZoomBtn(img) {
      const btn = document.createElement('button');
      btn.className = 'zoom-btn';
      btn.setAttribute('aria-label', 'Zoom');
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>';
      btn.addEventListener('click', e => {
        e.stopPropagation();
        document.getElementById('sl-lightbox-img').src = img.src;
        document.getElementById('sl-lightbox').classList.add('open');
      });
      return btn;
    }

    function initZoomBtns() {
      ensureLightbox();
      document.querySelectorAll('.screenshot-frame, .page-hero-image').forEach(frame => {
        if (frame.querySelector('.zoom-btn')) return;
        const img = frame.querySelector('img');
        if (!img) return;
        frame.appendChild(makeZoomBtn(img));
      });
      document.querySelectorAll('.qs-img-slide').forEach(slide => {
        if (slide.querySelector('.zoom-btn')) return;
        const img = slide.querySelector('img');
        if (!img) return;
        slide.appendChild(makeZoomBtn(img));
      });
      document.querySelectorAll('.companion-banner').forEach(frame => {
        if (frame.querySelector('.zoom-btn')) return;
        const img = frame.querySelector('img');
        if (!img) return;
        const btn = makeZoomBtn(img);
        btn.style.cssText = 'position:absolute;bottom:10px;right:10px;width:32px;height:32px;background:rgba(0,0,0,0.55);border:none;border-radius:6px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;z-index:10;';
        frame.appendChild(btn);
      });
      document.querySelectorAll('.carousel-slide').forEach(slide => {
        if (slide.querySelector('.zoom-btn')) return;
        const img = slide.querySelector('img');
        if (!img) return;
        const btn = makeZoomBtn(img);
        slide.appendChild(btn);
        img.addEventListener('mouseenter', () => { btn.style.opacity = '1'; });
        img.addEventListener('mouseleave', (e) => { if (e.relatedTarget !== btn && !btn.contains(e.relatedTarget)) btn.style.opacity = '0'; });
        btn.addEventListener('mouseleave', () => { btn.style.opacity = '0'; });
      });
      document.querySelectorAll('.doc-acc-img-wrap').forEach(wrap => {
        if (wrap.querySelector('.zoom-btn')) return;
        const img = wrap.querySelector('img');
        if (!img) return;
        wrap.appendChild(makeZoomBtn(img));
      });
    }

    initZoomBtns();
    document.addEventListener('astro:page-load', initZoomBtns);
    document.addEventListener('astro:after-swap', initZoomBtns);
  })();

  // ── Quickstart / How-To tabs: each .qs-stepper is independent ───
  function slugifyTab(text: string): string {
    return text.trim().toLowerCase()
      .replace(/ä/g, 'a').replace(/ö/g, 'o').replace(/ü/g, 'u').replace(/ß/g, 'ss')
      .replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
  }

  // Event delegation: one persistent listener handles all tab clicks,
  // regardless of when the DOM was built or swapped by View Transitions.
  document.addEventListener('click', (e: MouseEvent) => {
    const tab = (e.target as HTMLElement).closest<HTMLElement>('.qs-tab');
    if (!tab) return;
    e.preventDefault();
    const stepper = tab.closest<HTMLElement>('.qs-stepper');
    if (!stepper) return;
    const tabs   = Array.from(stepper.querySelectorAll<HTMLElement>('.qs-tab'));
    const panels = Array.from(stepper.querySelectorAll<HTMLElement>('.qs-panel'));
    const index  = tabs.indexOf(tab);
    if (index < 0) return;
    panels.forEach((p, i) => p.classList.toggle('qs-active', i === index));
    tabs.forEach((t, i)   => t.classList.toggle('qs-active', i === index));
    const stepperIdx = Array.from(document.querySelectorAll('.qs-stepper')).indexOf(stepper);
    sessionStorage.setItem(`qs-tab:${location.pathname}:${stepperIdx}`, String(index));
    const slug = slugifyTab(tab.textContent || '');
    if (slug) history.replaceState(null, '', '#' + slug);
  });

  // Restore active tab after every page load / View Transition swap.
  // No qsReady guard — this is idempotent (just sets classes).
  function initQsTabs() {
    document.querySelectorAll<HTMLElement>('.qs-stepper').forEach((stepper, stepperIdx) => {
      const tabs   = Array.from(stepper.querySelectorAll<HTMLElement>('.qs-tab'));
      const panels = Array.from(stepper.querySelectorAll<HTMLElement>('.qs-panel'));
      if (!tabs.length || !panels.length) return;

      const storageKey = `qs-tab:${location.pathname}:${stepperIdx}`;
      const hash       = location.hash.slice(1);
      const hashIndex  = hash ? tabs.findIndex(t => slugifyTab(t.textContent || '') === hash) : -1;
      const savedIndex = parseInt(sessionStorage.getItem(storageKey) || '-1', 10);
      const initial    = hashIndex >= 0 ? hashIndex
                       : (savedIndex >= 0 && savedIndex < tabs.length ? savedIndex : 0);

      panels.forEach((p, i) => p.classList.toggle('qs-active', i === initial));
      tabs.forEach((t, i)   => t.classList.toggle('qs-active', i === initial));
    });
  }

  document.addEventListener('astro:page-load', initQsTabs);

  // ── Quickstart image carousel (.qs-img-carousel) ────────────────────
  function initQsImgCarousels() {
    document.querySelectorAll<HTMLElement>('.qs-img-carousel').forEach(carousel => {
      if ((carousel as any)._qsImgReady) return;
      (carousel as any)._qsImgReady = true;
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.qs-img-slide'));
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.qs-img-next');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.qs-img-prev');
      if (slides.length < 2) return;
      let idx = 0;
      function showSlide(i: number) {
        slides.forEach((s, j) => s.classList.toggle('qs-img-active', j === i));
        if (prevBtn) prevBtn.style.display = i > 0 ? 'flex' : 'none';
        if (nextBtn) nextBtn.style.display = i < slides.length - 1 ? 'flex' : 'none';
      }
      nextBtn?.addEventListener('click', () => { idx = Math.min(idx + 1, slides.length - 1); showSlide(idx); });
      prevBtn?.addEventListener('click', () => { idx = Math.max(idx - 1, 0); showSlide(idx); });
      showSlide(0);
    });
  }
  initQsImgCarousels();
  document.addEventListener('astro:page-load', initQsImgCarousels);

  // ── Image toggles (arrow button cycles through images) ──────────────
  function initImgToggles() {
    document.querySelectorAll<HTMLElement>('.img-toggle').forEach(wrapper => {
      if ((wrapper as any)._toggleReady) return;
      (wrapper as any)._toggleReady = true;
      const imgs: string[] = JSON.parse(wrapper.dataset.imgs || '[]');
      if (imgs.length < 2) return;
      let idx = 0;
      const img = wrapper.querySelector('img') as HTMLImageElement;
      const btn = wrapper.querySelector<HTMLButtonElement>('.img-toggle-btn');
      if (!img || !btn) return;
      btn.addEventListener('click', () => {
        idx = (idx + 1) % imgs.length;
        img.src = imgs[idx];
      });
    });
  }
  initImgToggles();
  document.addEventListener('astro:page-load', initImgToggles);

  // ── Keep language prefix when navigating between products ────
  function updateProductNavLinks() {
    const isDE   = window.location.pathname.startsWith('/de');
    const prefix = isDE ? '/de' : '';
    const hub  = document.getElementById('pnav-hub')  as HTMLAnchorElement | null;
    const edge = document.getElementById('pnav-edge') as HTMLAnchorElement | null;
    const comp = document.getElementById('pnav-companion') as HTMLAnchorElement | null;
    if (hub)  hub.href  = prefix + '/hub';
    if (edge) edge.href = prefix + '/edge';
    if (comp) comp.href = prefix + '/companion';
  }

  function setActiveProduct() {
    const path = window.location.pathname;
    const hub  = document.getElementById('pnav-hub');
    const edge = document.getElementById('pnav-edge');
    const comp = document.getElementById('pnav-companion');
    [hub, edge, comp].forEach(el => el?.classList.remove('active'));
    if (path.includes('/edge'))           edge?.classList.add('active');
    else if (path.includes('/companion')) comp?.classList.add('active');
    else                                  hub?.classList.add('active');
    updateProductNavLinks();
  }

  setActiveProduct();
  document.addEventListener('astro:page-load',  setActiveProduct);
  document.addEventListener('astro:after-swap', setActiveProduct);
</script>
