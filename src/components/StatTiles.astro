---
interface Tile {
  label: string;
  value: string;
  sub: string;
}
interface Props {
  tiles: Tile[];
}
const { tiles } = Astro.props;
---

<div class="st-grid">
  {tiles.map((t) => (
    <div class="st-tile">
      <span class="st-label">{t.label}</span>
      <span class="st-value">{t.value}</span>
      <span class="st-sub">{t.sub}</span>
    </div>
  ))}
</div>

<style>
  .st-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-bottom: 2rem;
  }
  .st-tile {
    background: var(--sl-color-gray-6);
    border-radius: 8px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .st-label {
    font-size: 12px;
    color: var(--sl-color-gray-3);
    line-height: 1.3;
  }
  .st-value {
    font-size: 24px;
    font-weight: 500;
    color: var(--sl-color-gray-1);
    line-height: 1.2;
  }
  .st-sub {
    font-size: 12px;
    color: var(--sl-color-gray-4);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
