---
// Matches Starlight's own PageTitle.astro anchor id.
const PAGE_TITLE_ID = '_top';

const PRODUCTS = ['hub', 'edge', 'companion', 'deepview'];

const segments = Astro.url.pathname.split('/').filter(Boolean);
const product =
  segments.length === 1 && PRODUCTS.includes(segments[0])
    ? segments[0]
    : segments.length === 2 && segments[0] === 'de' && PRODUCTS.includes(segments[1])
      ? segments[1]
      : null;

const { entry } = Astro.locals.starlightRoute;
---

{product ? (
  <div class="page-title-logo">
    <img src={`/logos/${product}-light.svg`} alt={entry.data.title} class="dark:sl-hidden" />
    <img src={`/logos/${product}-dark.svg`} alt={entry.data.title} class="light:sl-hidden" />
    {product === 'deepview' && (
      <p class="page-title-powered">
        powered by{' '}
        <a href="https://www.marpledata.com/marple-insight" target="_blank" rel="noopener">
          Marple Insight
        </a>
      </p>
    )}
  </div>
) : (
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
)}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
    .page-title-logo {
      margin-top: 1rem;
    }
    .page-title-logo img {
      height: 2.5rem;
      width: auto;
      display: block;
    }
    .page-title-powered {
      margin: 0.5rem 0 0;
      font-size: 0.8125rem;
      line-height: 1.4;
      color: var(--sl-color-gray-3);
    }
    .page-title-powered a {
      color: var(--sl-color-white);
      font-weight: 600;
      text-decoration: none;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }
    .page-title-powered a:hover {
      color: var(--sl-color-accent);
      border-bottom-color: currentColor;
    }
    .page-title-powered a::after {
      content: ' ↗';
      font-weight: 400;
      color: var(--sl-color-gray-3);
    }
  }
</style>
