---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Sidebar.astro';

const locale = Astro.props.locale ?? '';
const isDE = locale === 'de';
const prefix = isDE ? '/de' : '';
const currentPath = Astro.url.pathname;
---

<!-- Pre-define sl-sidebar-restore as no-op so Starlight's SidebarPersister
     can never set details.open = false and collapse sidebar groups. -->
<script is:inline>
  if (typeof customElements !== 'undefined' && !customElements.get('sl-sidebar-restore')) {
    customElements.define('sl-sidebar-restore', class extends HTMLElement {});
  }
  // Apply sidebar state before first paint — desktop only
  try {
    if (window.innerWidth >= 800 && sessionStorage.getItem('sl-sidebar-open') === 'false') {
      document.documentElement.classList.add('sidebar-hidden');
      document.documentElement.style.setProperty('--sl-sidebar-width', '0px');
      document.documentElement.style.setProperty('--sl-content-inline-start', '3rem');
      document.documentElement.style.setProperty('--sl-content-width', 'calc(100vw - 8.5rem)');
    }
  } catch(e) {}
</script>

<nav class="mobile-product-nav" aria-label="Products">
  <a href={`${prefix}/hub`}       class:list={['mpnav', { 'mpnav-active': currentPath.includes('/hub') }]}>Hub</a>
  <a href={`${prefix}/edge`}      class:list={['mpnav', { 'mpnav-active': currentPath.includes('/edge') }]}>Edge (Crawler)</a>
  <a href={`${prefix}/companion`} class:list={['mpnav', { 'mpnav-active': currentPath.includes('/companion') }]}>Companion</a>
  <a href={`${prefix}/deepview`}  class:list={['mpnav', { 'mpnav-active': currentPath.includes('/deepview') }]}>Deepview</a>
</nav>

<Default {...Astro.props} />

<!-- Toggle button lives in the HTML, not JS, so it's never destroyed on navigation -->
<button id="sl-sidebar-btn" aria-label="Sidebar ein-/ausblenden">
  <span id="sl-btn-arrow">&#x2039;</span>
</button>

<style>
  /* Mobile-only product navigation at top of hamburger menu */
  .mobile-product-nav {
    display: flex;
    flex-direction: column;
    padding: 1rem 0.875rem 0.5rem;
    gap: 0.25rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    margin-bottom: 0.5rem;
  }
  .mpnav {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .mpnav-active {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  @media (min-width: 50rem) {
    .mobile-product-nav { display: none; }
  }

  /* Desktop: sidebar groups always fully expanded, no collapse arrows */
  @media (min-width: 50rem) {
    :global(.sidebar details) {
      display: block !important;
    }
    :global(.sidebar details > :not(summary)) {
      display: block !important;
    }
    :global(.sidebar summary svg),
    :global(.sidebar summary .caret) {
      display: none !important;
    }
    :global(.sidebar summary) {
      pointer-events: none;
      cursor: default;
    }
  }

  /* ── Uniform left alignment for all sidebar items ── */
  :global(.sidebar ul) {
    padding: 0 !important;
    margin: 0 !important;
  }
  :global(.sidebar ul ul li) {
    margin-inline-start: 0 !important;
    border-inline-start: none !important;
    padding-inline-start: 0 !important;
  }
  :global(.sidebar a),
  :global(.sidebar summary) {
    padding-inline-start: 0.875rem !important;
  }

  /* Product logo swapped in for the top-level group label text (see script
     below) — sized to the sidebar row's line-height, not the source SVG's
     own dimensions. */
  :global(.sidebar .product-logo) {
    display: block;
    height: 1.65rem;
    width: auto;
  }
  /* Separator below the logo row, ahead of the product's own page links */
  :global(.sidebar summary:has(.product-logo)) {
    padding-block-end: 0.75rem !important;
    margin-block-end: 0.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
</style>

<script>
  const STORAGE_KEY = 'sl-sidebar-open';

  function productPrefix(pathname: string): string | null {
    const p = pathname.replace(/^\/de(\/|$)/, '/');
    if (p.startsWith('/edge'))      return 'Edge';
    if (p.startsWith('/hub'))       return 'Hub';
    if (p.startsWith('/companion')) return 'Companion';
    if (p.startsWith('/deepview'))  return 'Deepview';
    return null;
  }

  function applyTitlePrefix(pathname: string, rawTitle: string): string {
    const prefix = productPrefix(pathname);
    return prefix ? `Invisyne - ${prefix} - ${rawTitle}` : `Invisyne - ${rawTitle}`;
  }

  document.title = applyTitlePrefix(location.pathname, document.title);

  function getSidebarOpen(): boolean {
    return sessionStorage.getItem(STORAGE_KEY) !== 'false';
  }

  function setSidebarOpen(value: boolean) {
    sessionStorage.setItem(STORAGE_KEY, String(value));
  }

  function applyLayout() {
    if (window.innerWidth < 800) return;
    const open = getSidebarOpen();
    document.documentElement.classList.toggle('sidebar-hidden', !open);
    document.documentElement.style.setProperty('--sl-sidebar-width', open ? '' : '0px');
    document.documentElement.style.setProperty('--sl-content-inline-start', open ? '' : '3rem');
    document.documentElement.style.setProperty('--sl-content-width', open ? '' : 'calc(100vw - 8.5rem)');
    const arrow = document.getElementById('sl-btn-arrow');
    if (arrow) arrow.innerHTML = open ? '&#x2039;' : '&#x203a;';
  }

  function initToggle() {
    const btn = document.getElementById('sl-sidebar-btn');
    if (!btn) return;

    if (!(btn as HTMLElement).dataset.ready) {
      (btn as HTMLElement).dataset.ready = '1';
      if (btn.parentElement !== document.body) {
        document.body.appendChild(btn);
      }
      btn.addEventListener('click', () => {
        setSidebarOpen(!getSidebarOpen());
        applyLayout();
      });
    }

    applyLayout();
  }

  const PRODUCT_LOGOS: Record<string, string> = {
    'Hub': '/logos/hub-black.svg',
    'Edge (Crawler)': '/logos/edge-black.svg',
    'Companion': '/logos/companion-black.svg',
    'Deepview': '/logos/deepview-black.svg',
  };

  // Swaps the top-level sidebar group label text (Hub, Edge (Crawler),
  // Companion, Deepview) for the product's black wordmark logo. Matched by
  // exact text rather than DOM position, since Starlight re-renders the
  // sidebar on every astro:page-load and there's no other stable hook here —
  // none of the nested group labels (Analysis, Functions, ...) collide with
  // these names, so exact-match is safe.
  function initProductLogos() {
    document.querySelectorAll('.sidebar summary .large').forEach((el) => {
      const label = el.textContent?.trim();
      if (!label || !(label in PRODUCT_LOGOS) || (el as HTMLElement).dataset.logoApplied) return;
      (el as HTMLElement).dataset.logoApplied = '1';
      const img = document.createElement('img');
      img.src = PRODUCT_LOGOS[label];
      img.alt = label;
      img.className = 'product-logo';
      el.replaceChildren(img);
    });
  }

  function initUiTabs() {
    document.querySelectorAll('.ui-tabs').forEach((tabs) => {
      if ((tabs as HTMLElement).dataset.ready) return;
      (tabs as HTMLElement).dataset.ready = '1';
      tabs.querySelectorAll('.ui-tab').forEach((btn) => {
        btn.addEventListener('click', function(this: HTMLElement) {
          const key = this.dataset.tab;
          tabs.querySelectorAll('.ui-tab').forEach((b) => b.classList.remove('active'));
          tabs.querySelectorAll('.ui-tab-panel').forEach((p) => p.classList.remove('active'));
          this.classList.add('active');
          tabs.querySelector(`.ui-tab-panel[data-panel="${key}"]`)?.classList.add('active');
        });
      });
    });
  }

  function initQsStepper() {
    document.querySelectorAll('.qs-stepper').forEach((stepper) => {
      if ((stepper as HTMLElement).dataset.ready) return;
      (stepper as HTMLElement).dataset.ready = '1';
      const tabs = Array.from(stepper.querySelectorAll('.qs-tab'));
      const panels = Array.from(stepper.querySelectorAll('.qs-panel'));
      function activate(idx: number) {
        tabs.forEach((t, i) => t.classList.toggle('qs-active', i === idx));
        panels.forEach((p, i) => p.classList.toggle('qs-active', i === idx));
      }
      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', (e) => { e.preventDefault(); activate(idx); });
      });
      activate(0);
    });
  }

  // Apply sidebar state AND theme to the incoming document BEFORE the swap so
  // there is never a frame where layout or theme is in the wrong state.
  document.addEventListener('astro:before-swap', (e: any) => {
    const theme = document.documentElement.dataset.theme;
    if (theme) e.newDocument.documentElement.dataset.theme = theme;

    const newTitle = e.newDocument.querySelector('title')?.textContent;
    if (newTitle) document.title = applyTitlePrefix(e.to.pathname, newTitle);

    if (window.innerWidth >= 800) {
      const open = getSidebarOpen();
      if (!open) {
        e.newDocument.documentElement.classList.add('sidebar-hidden');
        e.newDocument.documentElement.style.setProperty('--sl-sidebar-width', '0px');
        e.newDocument.documentElement.style.setProperty('--sl-content-inline-start', '3rem');
        e.newDocument.documentElement.style.setProperty('--sl-content-width', 'calc(100vw - 8.5rem)');
      }
    }
  });

  initToggle();
  initUiTabs();
  initQsStepper();
  initProductLogos();
  document.addEventListener('astro:page-load', () => { initToggle(); initUiTabs(); initQsStepper(); initProductLogos(); });
</script>
