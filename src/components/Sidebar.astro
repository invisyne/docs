---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<!-- Pre-define sl-sidebar-restore as no-op so Starlight's SidebarPersister
     can never set details.open = false and collapse sidebar groups. -->
<script is:inline>
  if (typeof customElements !== 'undefined' && !customElements.get('sl-sidebar-restore')) {
    customElements.define('sl-sidebar-restore', class extends HTMLElement {});
  }
  // Apply sidebar state before first paint to prevent layout shift on navigation
  try {
    if (sessionStorage.getItem('sl-sidebar-open') === 'false') {
      document.documentElement.classList.add('sidebar-hidden');
      document.documentElement.style.setProperty('--sl-sidebar-width', '0px');
      document.documentElement.style.setProperty('--sl-content-inline-start', '3rem');
      document.documentElement.style.setProperty('--sl-content-width', 'calc(100vw - 8.5rem)');
    }
  } catch(e) {}
</script>

<Default {...Astro.props} />

<!-- Toggle button lives in the HTML, not JS, so it's never destroyed on navigation -->
<button id="sl-sidebar-btn" aria-label="Sidebar ein-/ausblenden">
  <span id="sl-btn-arrow">&#x2039;</span>
</button>

<style>
  /* Make sidebar groups always fully expanded — no collapse at all */
  :global(.sidebar details) {
    display: block !important;
  }
  /* Force all children of details visible, even without the open attribute.
     This prevents the layout jump caused by JS opening details after render. */
  :global(.sidebar details > :not(summary)) {
    display: block !important;
  }
  :global(.sidebar summary svg),
  :global(.sidebar summary .caret) {
    display: none !important;
  }
  :global(.sidebar summary) {
    pointer-events: none;
    cursor: default;
  }

  /* ── Uniform left alignment for all sidebar items ── */
  :global(.sidebar ul) {
    padding: 0 !important;
    margin: 0 !important;
  }
  :global(.sidebar ul ul li) {
    margin-inline-start: 0 !important;
    border-inline-start: none !important;
    padding-inline-start: 0 !important;
  }
  :global(.sidebar a),
  :global(.sidebar summary) {
    padding-inline-start: 0.875rem !important;
  }
</style>

<script>
  const STORAGE_KEY = 'sl-sidebar-open';

  function getSidebarOpen(): boolean {
    return sessionStorage.getItem(STORAGE_KEY) !== 'false';
  }

  function setSidebarOpen(value: boolean) {
    sessionStorage.setItem(STORAGE_KEY, String(value));
  }

  function applyLayout() {
    const open = getSidebarOpen();
    document.documentElement.classList.toggle('sidebar-hidden', !open);
    // main-frame uses --sl-content-inline-start which resolves to --sl-sidebar-width
    // Set both inline (highest specificity) to remove the left offset
    document.documentElement.style.setProperty('--sl-sidebar-width', open ? '' : '0px');
    document.documentElement.style.setProperty('--sl-content-inline-start', open ? '' : '3rem');
    document.documentElement.style.setProperty('--sl-content-width', open ? '' : 'calc(100vw - 8.5rem)');
    const arrow = document.getElementById('sl-btn-arrow');
    if (arrow) arrow.innerHTML = open ? '&#x2039;' : '&#x203a;';
  }

  function initToggle() {
    const btn = document.getElementById('sl-sidebar-btn');
    if (!btn) return;

    if (!(btn as HTMLElement).dataset.ready) {
      (btn as HTMLElement).dataset.ready = '1';
      if (btn.parentElement !== document.body) {
        document.body.appendChild(btn);
      }
      btn.addEventListener('click', () => {
        setSidebarOpen(!getSidebarOpen());
        applyLayout();
      });
    }

    applyLayout();
  }

  function initUiTabs() {
    document.querySelectorAll('.ui-tabs').forEach((tabs) => {
      if ((tabs as HTMLElement).dataset.ready) return;
      (tabs as HTMLElement).dataset.ready = '1';
      tabs.querySelectorAll('.ui-tab').forEach((btn) => {
        btn.addEventListener('click', function(this: HTMLElement) {
          const key = this.dataset.tab;
          tabs.querySelectorAll('.ui-tab').forEach((b) => b.classList.remove('active'));
          tabs.querySelectorAll('.ui-tab-panel').forEach((p) => p.classList.remove('active'));
          this.classList.add('active');
          tabs.querySelector(`.ui-tab-panel[data-panel="${key}"]`)?.classList.add('active');
        });
      });
    });
  }

  function initQsStepper() {
    document.querySelectorAll('.qs-stepper').forEach((stepper) => {
      if ((stepper as HTMLElement).dataset.ready) return;
      (stepper as HTMLElement).dataset.ready = '1';
      const tabs = Array.from(stepper.querySelectorAll('.qs-tab'));
      const panels = Array.from(stepper.querySelectorAll('.qs-panel'));
      function activate(idx: number) {
        tabs.forEach((t, i) => t.classList.toggle('qs-active', i === idx));
        panels.forEach((p, i) => p.classList.toggle('qs-active', i === idx));
      }
      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', (e) => { e.preventDefault(); activate(idx); });
      });
      activate(0);
    });
  }

  // Apply sidebar state AND theme to the incoming document BEFORE the swap so
  // there is never a frame where layout or theme is in the wrong state.
  document.addEventListener('astro:before-swap', (e: any) => {
    // Preserve theme
    const theme = document.documentElement.dataset.theme;
    if (theme) e.newDocument.documentElement.dataset.theme = theme;

    // Preserve sidebar state
    const open = getSidebarOpen();
    if (!open) {
      e.newDocument.documentElement.classList.add('sidebar-hidden');
      e.newDocument.documentElement.style.setProperty('--sl-sidebar-width', '0px');
      e.newDocument.documentElement.style.setProperty('--sl-content-inline-start', '3rem');
      e.newDocument.documentElement.style.setProperty('--sl-content-width', 'calc(100vw - 8.5rem)');
    }
  });

  initToggle();
  initUiTabs();
  initQsStepper();
  document.addEventListener('astro:page-load', () => { initToggle(); initUiTabs(); initQsStepper(); });
</script>
