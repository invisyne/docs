---
interface Props {
  images: { src: string; alt: string; label: string; description?: string }[];
}
const { images } = Astro.props;
---

{/* `not-content` opts out of Starlight's `* + *` margin-top rule, which would
    otherwise push every thumbnail and caption 1rem down from its sibling. */}
<div class="ic-wrapper not-content">
  <div class="ic-stage">
    {images.map((img, i) => (
      <div class="ic-slide" data-active={i === 0 ? '' : null}>
        <div class="ic-img">
          <img src={img.src} alt={img.alt} />
        </div>
        <div class="ic-caption">
          <div class="ic-label">{img.label}</div>
          {img.description && <div class="ic-desc">{img.description}</div>}
        </div>
      </div>
    ))}
  </div>

  {images.length > 1 && (
    <div class="ic-thumbs">
      {images.map((img, i) => (
        <button
          class="ic-thumb"
          type="button"
          aria-label={img.label}
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-active={i === 0 ? '' : null}
        >
          <img src={img.src} alt="" />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .ic-wrapper {
    border: 0.5px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  /* Slides are grid-stacked so the box keeps the height of its tallest
     entry — switching images never shifts the page below. */
  .ic-stage {
    display: grid;
  }

  /* Hidden via opacity, not visibility: `visibility` is inherited, so a
     `visibility: visible` child would escape the `.qs-panel` tab hiding. */
  .ic-slide {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1rem;
  }
  .ic-slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Fixed tile so every image gets the same frame regardless of aspect ratio —
     560×276 fits the widest image at full height without upscaling. */
  .ic-img {
    flex: 0 0 auto;
    width: min(560px, 100%);
    height: 276px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 0.5px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 8px;
  }
  .ic-img img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    margin: 0;
  }

  .ic-caption {
    flex: 1 1 200px;
  }
  .ic-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }
  .ic-desc {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }

  .ic-thumbs {
    display: flex;
    gap: 8px;
    padding: 10px 1rem;
    overflow-x: auto;
    background: var(--sl-color-gray-6);
    border-top: 0.5px solid var(--sl-color-gray-5);
  }
  .ic-thumb {
    flex: 0 0 auto;
    width: 68px;
    height: 50px;
    padding: 3px;
    background: #fff;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    cursor: pointer;
    opacity: 0.6;
    transition:
      opacity 0.15s ease,
      border-color 0.15s ease;
  }
  .ic-thumb:hover {
    opacity: 1;
  }
  .ic-thumb[data-active] {
    opacity: 1;
    border-color: var(--sl-color-gray-2);
    box-shadow: 0 0 0 1px var(--sl-color-gray-2);
  }
  .ic-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin: 0;
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll('.ic-wrapper').forEach((wrapper) => {
      const slides = wrapper.querySelectorAll<HTMLElement>('.ic-slide');
      const thumbs = wrapper.querySelectorAll<HTMLElement>('.ic-thumb');
      if (thumbs.length < 2) return;

      function go(index: number) {
        slides.forEach((el, i) => el.toggleAttribute('data-active', i === index));
        thumbs.forEach((el, i) => {
          el.toggleAttribute('data-active', i === index);
          el.setAttribute('aria-pressed', String(i === index));
        });
      }

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => go(i));
        thumb.addEventListener('keydown', (e: KeyboardEvent) => {
          const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!dir) return;
          e.preventDefault();
          const next = (i + dir + thumbs.length) % thumbs.length;
          go(next);
          thumbs[next].focus();
        });
      });
    });
  }

  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
